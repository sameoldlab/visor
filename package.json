    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.56.0",
    "eslint-plugin-svelte": "^2.41.0",
    "execa": "9.3.0",
    "sass": "^1.77.7",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.4",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
